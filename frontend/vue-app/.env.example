# Frontend API base URLs (baked in at build time).
# For local dev, omit or leave as localhost. For deploy (e.g. test.dlux.io), set these
# so the app calls the real backends instead of localhost.

# DGraph / read API (social, subscription, governance, markets). Used for /social/posts, /graphql, etc.
VITE_DGRAPH_SERVICE_URL=https://gql.dlux.io

# SUI service (auth, dApps, billing)
VITE_SUI_SERVICE_URL=https://sui.dlux.io

# Walrus (blobs, premium, ads gateway)
VITE_WALRUS_SERVICE_URL=https://walrus.dlux.io

# Optional: auth cookie domain when frontend is on a subdomain (e.g. .test.dlux.io)
# VITE_AUTH_COOKIE_DOMAIN=.test.dlux.io

# Optional: root domain for links
# VITE_APP_ROOT_DOMAIN=test.dlux.io

# === SUI Network Configuration (mainnet 2026-02-10) ===
# Set these after deploying contracts to your target network (testnet or mainnet)
# Run: ./tests/e2e/scripts/deploy-contracts-testnet.sh (for testnet)
#   or: ./scripts/deploy-contracts-mainnet.sh (for mainnet)

# Package ID from `sui client publish` (required for on-chain dApp posting)
VITE_SUI_PACKAGE_ID=0x5bc3f9d6132ba769548d329498c8dcb0d84a2b979a5dd9554d05fd1763fd3b54

# PostingFeePool shared object ID (from contract deployment output)
VITE_POSTING_POOL_ID=0x63167c0fd8c2da398a54249eae1794433ed5feb4091e606a2e5f1e96167814a2

# PostingTreasuryConfig shared object (canonical PM/foundation addresses - caller cannot override)
VITE_POSTING_TREASURY_CONFIG_ID=0x73caabb1bbe29ab26c6b47e16215a7d05dbf33d4d027f2025417e10804e5dd01

# DappRegistry shared object (claimed permlinks + time lock / mute - required for post_dapp)
VITE_POSTING_REGISTRY_ID=0x94b48dfe4cf2a6691a3b3356abb6cb4bab3a178eddcb6bee04fb36b56ce23fbe

# GovernanceConfig shared object (votable params: PM duration, fees, revenue splits)
VITE_GOVERNANCE_CONFIG_ID=0x03c1be52a01c82e2c2d62bdbf0cb4fdfe24ccda5b81f159cccbeffd7dd121d3c

# SUI RPC URL (optional - defaults to mainnet or testnet based on package ID)
# Testnet: VITE_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# Mainnet: VITE_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
VITE_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
