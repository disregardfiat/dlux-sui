# Server Configuration
PORT=3002
LOG_LEVEL=info

# Walrus Configuration (official publisher per docs.wal.app)
# If not set, auto-detected from SUI_NETWORK env var
# Testnet: WALRUS_BASE_URL=https://publisher.walrus-testnet.walrus.space
# Mainnet: WALRUS_BASE_URL=https://walrus-mainnet.mrgnlabs.xyz
# WALRUS_BASE_URL=https://walrus-mainnet.mrgnlabs.xyz

# Storage Configuration
MAX_FILE_SIZE=52428800
# 50MB in bytes

# Optional: persist blobs to disk so they survive restarts (e.g. deploy-server.sh).
# If unset, blobs are in-memory only and are lost on PM2 restart.
# Example: /home/ubuntu/dlux-sui/data/walrus or ./data/walrus
# WALRUS_DATA_DIR=

# Ad tracking (ZK)
ZK_SERVICE_URL=http://localhost:3010
DGRAPH_SERVICE_URL=http://localhost:3003

# Consent gating
CONSENT_REQUIRED=true
CONSENT_COOKIE_NAME=dlux_consent
CONSENT_COOKIE_VALUE=accepted
# Optional redirect to consent UI
CONSENT_REDIRECT_URL=

# Premium content configuration
PLATFORM_FEE_PERCENT=0.10
FOUNDATION_ADDRESS=0x3d4e565f798ad88b8e99882f37ab1198430c58ff0ecdca70c57cf16bc9fd84ec
MODERATION_ADDRESSES=0xmoderator1,0xmoderator2

# Database Configuration (when implemented)
# DATABASE_URL=postgresql://user:password@localhost:5433/walrus_service

# Redis Configuration (when implemented)
# REDIS_URL=redis://localhost:6380

# Seal Configuration (for premium content encryption)
# SEAL_BASE_URL=https://seal-testnet.sui.io