# Server Configuration
PORT=3003
LOG_LEVEL=info
NODE_ENV=development

# JWT (same secret as sui-service) - required for personal-data routes (subscription, location, campaigns by advertiser)
JWT_SECRET=your-secret-key

# dGraph Configuration
DGRAPH_HOST=localhost:9080

# Blockchain indexer (set to true when SUI sync needed; default false to reduce CPU)
BLOCKCHAIN_INDEXER_ENABLED=false
# Poll interval in ms when enabled (default 300000 = 5 min; increase to reduce CPU further)
BLOCKCHAIN_INDEXER_POLL_INTERVAL=300000
DGRAPH_USER=groot
DGRAPH_PASSWORD=password

# GraphQL Configuration
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true

# ZK Service (for ad verification)
ZK_SERVICE_URL=http://localhost:3010

# Ad Impression Threshold (for Merkle aggregation)
AD_IMPRESSION_THRESHOLD=100

# Ad Click/Conversion Thresholds
AD_CLICK_THRESHOLD=100
AD_CONVERSION_THRESHOLD=25

# Ad Inventory (JSON array)
# Example:
# AD_INVENTORY_JSON=[{"id":"ad_1","title":"Try DLUX Pro","description":"Unlock premium tools","targetUrl":"https://dlux.io/pricing","placements":["gate"],"contentIds":[]}]
AD_INVENTORY_JSON=

# Foundation account (subscription recipient, platform-wide ad-free)
FOUNDATION_ADDRESS=0x3d4e565f798ad88b8e99882f37ab1198430c58ff0ecdca70c57cf16bc9fd84ec

# Default subscription ad (used when inventory is empty)
AD_DEFAULT_ENABLED=true
AD_DEFAULT_TITLE=Go Ad-Free with DLUX+
AD_DEFAULT_DESCRIPTION=Don't watch ads. Support your favorite creators directly with a DLUX subscription.
AD_DEFAULT_TARGET_URL=https://dlux.io/subscribe