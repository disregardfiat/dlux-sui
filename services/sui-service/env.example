# SUI Network Configuration
# Set to 'mainnet' for production, 'testnet' for testing
SUI_NETWORK=mainnet
# Options: mainnet, testnet, devnet, localnet

# RPC URL (optional; auto-derived from SUI_NETWORK if not set)
# Set to your own SUI node for better reliability/rate limits (e.g. http://your-node:9000)
# Testnet: SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# Mainnet: SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
# Custom: SUI_RPC_URL=http://localhost:9000
# SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Namespace filter - REQUIRED for indexer. Without this, indexer is disabled.
# Set to your deployed package ID from deploy-contracts-mainnet.sh or deploy-contracts-testnet.sh
# SUI_PACKAGE_ID=0x...
SUI_PACKAGE_ID=

# Modules to subscribe for events (comma-separated; default: all 5 in package)
SUI_EVENT_MODULE=metadata_pm,dapp_posting,ad_campaigns,ad_payments,ad_tracking

# PostingFeePool shared object ID (from dapp_posting init; required for on-chain dApp posting)
# Set from contract deployment output
# POSTING_POOL_ID=0x...
POSTING_POOL_ID=

# PostingTreasuryConfig shared object (canonical addresses - required for post_dapp build-tx)
# POSTING_TREASURY_CONFIG_ID=0x...
POSTING_TREASURY_CONFIG_ID=

# DappRegistry shared object (claimed permlinks + time lock / mute - required for post_dapp)
# POSTING_REGISTRY_ID=0x...
POSTING_REGISTRY_ID=

# Indexer mode: stream (WebSocket) or poll (default)
# stream = subscribeEvent via WebSocket, lower CPU, events arrive as they occur (recommended for mainnet/own node)
# poll = queryEvents every POLL_INTERVAL ms (fallback if RPC doesn't support WebSocket)
# If RPC returns 405 for WebSocket (e.g. public fullnode.testnet.sui.io), use poll or leave stream (indexer auto-falls back to poll)
# On mainnet or with your own SUI node, stream mode is recommended for real-time events.
INDEXER_MODE=stream

# Server Configuration
PORT=3001
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database Configuration (when implemented)
# DATABASE_URL=postgresql://user:password@localhost:5432/sui_service

# Redis Configuration (when implemented)
# REDIS_URL=redis://localhost:6379

# Polling Configuration (ms; only used when INDEXER_MODE=poll)
POLL_INTERVAL=30000

# Deploy -dump: when this path exists at startup, clear in-memory dApps only (new events indexed as usual).
# deploy-server.sh -dump creates the file; set this on server so sui-service sees it, e.g. /home/ubuntu/dlux-sui/.clear-dapps-on-next-start
# CLEAR_DAPPS_SENTINEL=/path/to/.clear-dapps-on-next-start

# Admin: allow GET /admin/backfill-tx?txDigest=XXX to ingest that tx's events (e.g. put cursor in front of a dApp post).
# ALLOW_ADMIN_BACKFILL=1

# Prediction Market Service
# Dgraph Service
DGRAPH_SERVICE_URL=http://localhost:3003

# Ad settlement (bridge: DGraph verified impressions → SUI record_impression_with_escrow)
# campaignId = DGraph campaign id; campaign must have onChainCampaignId and onChainEscrowId (PUT /campaigns/:id).
# GET /ads/settlement/impressions?campaignId=<dgraph_campaign_id>&limit=10
# POST /ads/revenue/distribute to pay creators (50%), foundation (30%), PM pool (20%).
# ADMIN_CAP_OBJECT_ID = object ID of AdminCap (from ad_payments init).
# REVENUE_POOL_OBJECT_ID = shared RevenuePool object ID.
# FOUNDATION_ADDRESS = SUI address for foundation share.
# PM_POOL_ADDRESS = SUI address for PM pool share.
# WALRUS_PROVIDER_ADDRESS = SUI address for Walrus node provider (gets 10% of drawdowns).
# ADMIN_CAP_OBJECT_ID=
# REVENUE_POOL_OBJECT_ID=
# FOUNDATION_ADDRESS=
# PM_POOL_ADDRESS=
# WALRUS_PROVIDER_ADDRESS=
# ADMIN_PRIVATE_KEY=
# CLOCK_OBJECT_ID=0x6

# Walrus Drawdown Scheduler (Off-Chain Batch Processing)
# Enable scheduled batch processing of Walrus drawdowns (recommended for high volume)
WALRUS_DRAWDOWN_ENABLED=true
# Interval between batch processing runs (in milliseconds, default: 1 hour)
WALRUS_DRAWDOWN_INTERVAL=3600000
# Service account private key for executing batch transfers (can use ADMIN_PRIVATE_KEY or separate account)
WALRUS_DRAWDOWN_SERVICE_PRIVATE_KEY=
# Alternative: Base64 encoded private key
# WALRUS_DRAWDOWN_SERVICE_KEY_B64=

# SuiNS Resolver Service
# Note: SUINS always uses mainnet API regardless of SUI_NETWORK setting
# This allows resolving mainnet SUINS names even when the app runs on testnet
# SUINS_SERVICE_URL should point to a mainnet SUINS resolver service
SUINS_SERVICE_URL=http://localhost:3012

# SuiNS Registration Link (optional)
# Example: https://suins.app/register
SUINS_REGISTRATION_URL=
# Optional referral tracking to share registration fees
SUINS_REFERRAL_CODE=
# Optional referral param key (default: ref)
SUINS_REFERRAL_PARAM=ref