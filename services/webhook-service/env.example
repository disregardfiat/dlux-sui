# Webhook Service Configuration
PORT=3011
LOG_LEVEL=info

# GitHub Webhook Secret
# Set this to match your GitHub webhook secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# Repository Configuration
REPO_PATH=/home/ubuntu/dlux-sui
# Use deploy-server.sh (includes frontend build); deploy.sh is legacy
DEPLOY_SCRIPT_PATH=/home/ubuntu/dlux-sui/deploy-server.sh

# Optional Dgraph reset configuration (triggered by commit flag)
DGRAPH_RESET_SCRIPT_PATH=/home/ubuntu/dlux-sui/scripts/reset-dgraph.sh
# DGRAPH_ALPHA_HTTP=http://localhost:8080
# DGRAPH_AUTH_TOKEN=
# DROP_MODE=drop_all

# Deployment Configuration
# Deploy production frontend on push to main branch
DEPLOY_BRANCH=main
# Deploy test frontend on push to move branch
TEST_DEPLOY_BRANCH=move
