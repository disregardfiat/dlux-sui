# Sandbox service (port 3007)
PORT=3007

# SUI service URL for dapps/lookup (author, permlink)
SUI_SERVICE_URL=http://localhost:3001

# Walrus service URL for fetching blobs (entry HTML and /walrus/:blobId proxy)
WALRUS_SERVICE_URL=http://localhost:3002

# Optional: DGraph for safety banner and ads
DGRAPH_SERVICE_URL=http://localhost:3003

# Optional: HTTP timeout for upstream requests (ms)
# HTTP_TIMEOUT_MS=15000

# On test server (dlux.io): use localhost or public URLs, e.g.:
# SUI_SERVICE_URL=https://sui.dlux.io
# WALRUS_SERVICE_URL=https://walrus.dlux.io
# Or keep localhost if all services run on the same host:
# SUI_SERVICE_URL=http://localhost:3001
# WALRUS_SERVICE_URL=http://localhost:3002
