# ZK Service Configuration
PORT=3010

# Circuit paths (compiled)
CIRCUIT_WASM_PATH=./circuits/ad-view-proof.wasm
CIRCUIT_ZKEY_PATH=./circuits/ad-view-proof.zkey

# Homomorphic Encryption Keys (base64 encoded)
# Generate with: node scripts/generate-keys.js
HOMOMORPHIC_PUBLIC_KEY=
HOMOMORPHIC_PRIVATE_KEY=

# DGraph Service (for impression tracking)
DGRAPH_SERVICE_URL=http://localhost:3003

# Logging
LOG_LEVEL=info
