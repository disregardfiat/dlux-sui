# Copy to .env.slush or export before running Slush E2E.
# This 12-word mnemonic restores the same test wallet across runs.
# Fund the derived address at: https://faucet.testnet.sui.io
# TEST_SLUSH_PASSWORD is used when importing (and to unlock on first pass).

TEST_SLUSH_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
TEST_SLUSH_PASSWORD=your-wallet-password
