# E2E tests against production dlux.io (SUI mainnet)
# Copy to .env.production and run: npx dotenv -e tests/e2e/.env.production -- playwright test
#
# WARNING: Running E2E tests against production will create real data.
# Use a dedicated test account and minimal budgets.

E2E_BASE_URL=https://dlux.io
SUI_SERVICE_URL=https://sui.dlux.io
DGRAPH_SERVICE_URL=https://gql.dlux.io
WALRUS_SERVICE_URL=https://walrus.dlux.io
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Key pairs (use a dedicated test wallet with minimal funds)
# TEST_ADVERTISER_PRIVATE_KEY=
# TEST_CREATOR_PRIVATE_KEY=
# PACKAGE_ID=
